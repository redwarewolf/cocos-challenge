DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PORT=3000

# Opcional — tamaño de página default compartido por todos los endpoints paginados
# (GET /instruments/search, GET /orders). Si no se define, se usan 20 (el máximo
# permitido por request es 100, fijo, no configurable).
# PAGE_SIZE=20

# Opcional — nivel de log de pino (fatal|error|warn|info|debug|trace). Default "info".
# LOG_LEVEL=info
