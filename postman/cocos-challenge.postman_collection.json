    {
      "name": "0. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 503 es un resultado válido: Neon (serverless) puede tardar en 'despertar' en el primer request.",
                  "pm.test('200 (ok) o 503 (DB todavía despertando)', () => {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  pm.test('status ok', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Portfolio",
      "item": [
        {
          "name": "GET /portfolio/1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/portfolio/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "portfolio",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('shape', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.eql(1);",
                  "  pm.expect(body.availableCash).to.be.a('number');",
                  "  pm.expect(body.positions).to.be.an('array');",
                  "  pm.expect(body.totalAccountValue).to.be.a('number');",
                  "  pm.expect(body.hasUnvaluedPositions).to.be.a('boolean');",
                  "});",
                  "",
                  "pm.test('el poder de compra descuenta lo reservado en órdenes NEW', () => {",
                  "  const { availableCash, reservedCash, buyingPower } = pm.response.json();",
                  "  pm.expect(reservedCash).to.be.a('number').and.to.be.at.least(0);",
                  "  pm.expect(buyingPower).to.eql(Math.round((availableCash - reservedCash) * 100) / 100);",
                  "});",
                  "",
                  "pm.test('cada posición trae rendimiento total y retorno diario', () => {",
                  "  const { positions } = pm.response.json();",
                  "  positions.forEach((p) => {",
                  "    // null cuando el instrumento no tiene cotización: el valor es desconocido, no cero.",
                  "    pm.expect(p, p.ticker).to.have.property('performancePct');",
                  "    if (p.performancePct !== null) {",
                  "      pm.expect(p.performancePct, p.ticker).to.be.a('number');",
                  "    }",
                  "    pm.expect(p, p.ticker).to.have.property('dailyReturnPct');",
                  "    if (p.dailyReturnPct !== null) {",
                  "      pm.expect(p.dailyReturnPct, p.ticker).to.be.a('number');",
                  "    }",
                  "  });",
                  "});",
                  "",
                  "pm.test('la tenencia comprometida en ventas NEW nunca supera la tenencia', () => {",
                  "  const { positions } = pm.response.json();",
                  "  positions.forEach((p) => {",
                  "    pm.expect(p.reservedQuantity, p.ticker).to.be.a('number').and.to.be.at.least(0);",
                  "    pm.expect(p.reservedQuantity, p.ticker).to.be.at.most(p.quantity);",
                  "  });",
                  "});",
                  "",
                  "pm.test('el retorno diario es auditable desde los precios del payload', () => {",
                  "  const { positions } = pm.response.json();",
                  "  positions.forEach((p) => {",
                  "    if (p.lastPrice === null || !p.previousClose) return;",
                  "    const esperado = Math.round(((p.lastPrice - p.previousClose) / p.previousClose) * 10000) / 100;",
                  "    pm.expect(p.dailyReturnPct, p.ticker).to.eql(esperado);",
                  "    pm.expect(p.marketValue, p.ticker).to.eql(Math.round(p.quantity * p.lastPrice * 100) / 100);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
