    {
      "name": "7. Idempotency-Key (bonus)",
      "item": [
        {
          "name": "POST /orders/cash — primer request con Idempotency-Key",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Key nueva por corrida de la colección, para no depender de un valor fijo",
                  "// que ya exista de una corrida anterior contra la misma DB.",
                  "if (!pm.collectionVariables.get('idempotencyKey')) {",
                  "  pm.collectionVariables.set('idempotencyKey', 'postman-' + Date.now());",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201, FILLED', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('FILLED');",
                  "  pm.expect(body.idempotencyKey).to.eql(pm.collectionVariables.get('idempotencyKey'));",
                  "  pm.collectionVariables.set('idempotencyOrderId', body.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": 2,\n  \"side\": \"CASH_IN\",\n  \"amount\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/v1/orders/cash",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "orders",
                "cash"
              ]
            }
          }
        },
        {
          "name": "POST /orders/cash — reintento con la misma key: no duplica",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
